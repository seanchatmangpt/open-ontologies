// ============================================================================
// INPUT/OUTPUT TYPES
// ============================================================================

/// Candidate solution for breed evaluation.
///
/// Tracks a proposed solution with its fitness score and any elimination reasons.
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct Candidate {
    /// Unique identifier for this candidate.
    pub id: String,

    /// Fitness score [0.0..=1.0], higher is better.
    pub score: f64,

    /// True if this candidate was eliminated during filtering.
    pub eliminated: bool,

    /// Reason for elimination (if eliminated = true).
    pub elimination_reason: Option<String>,
}

impl Candidate {
    /// Create a new candidate with default state.
    pub fn new(id: String, score: f64) -> Self {
        Self {
            id,
            score,
            eliminated: false,
            elimination_reason: None,
        }
    }

    /// Mark this candidate as eliminated with a reason.
    pub fn eliminate(mut self, reason: String) -> Self {
        self.eliminated = true;
        self.elimination_reason = Some(reason);
        self
    }
}

/// Fact: a key-value pair in the knowledge base.
///
/// Facts are assertions that the breed consumes during reasoning.
#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq, Hash)]
pub struct Fact {
    /// Assertion key (e.g., "symptom", "attribute", "constraint").
    pub key: String,

    /// Assertion value (e.g., "fever", "red", "5").
    pub value: String,
}

impl Fact {
    /// Create a new fact.
    pub fn new(key: impl Into<String>, value: impl Into<String>) -> Self {
        Self {
            key: key.into(),
            value: value.into(),
        }
    }
}

impl std::fmt::Display for Fact {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{}={}", self.key, self.value)
    }
}

/// Breed execution input.
///
/// Contains candidates to evaluate, facts (knowledge), and scenario context.
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct BreedInput {
    /// Candidate solutions for breed to filter/rank.
    pub candidates: Vec<Candidate>,

    /// Known facts (key-value assertions).
    pub facts: Vec<Fact>,

    /// Scenario context (free-form description).
    pub scenarios: Option<String>,
}

impl BreedInput {
    /// Create a new breed input.
    pub fn new(candidates: Vec<Candidate>, facts: Vec<Fact>) -> Self {
        Self {
            candidates,
            facts,
            scenarios: None,
        }
    }

    /// Add scenario context.
    pub fn with_scenario(mut self, scenario: String) -> Self {
        self.scenarios = Some(scenario);
        self
    }
}

/// Breed execution output.
///
/// Contains the selected candidate, reasoning trace, and inferred facts.
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct BreedOutput {
    /// Selected candidate (highest score post-filtering).
    pub selected: Option<Candidate>,

    /// Human-readable explanation of the selection.
    pub explanation: String,

    /// Inference trace: step-by-step reasoning record.
    pub inference_trace: Vec<String>,

    /// Breed that produced this output.
    pub breed: BreedId,

    /// Facts inferred during reasoning.
    pub facts: Vec<Fact>,
}

impl BreedOutput {
    /// Create a new breed output.
    pub fn new(breed: BreedId, explanation: String) -> Self {
        Self {
            selected: None,
            explanation,
            inference_trace: Vec::new(),
            breed,
            facts: Vec::new(),
        }
    }

    /// Set the selected candidate.
    pub fn with_selected(mut self, candidate: Candidate) -> Self {
        self.selected = Some(candidate);
        self
    }

    /// Add a trace line.
    pub fn trace(mut self, line: impl Into<String>) -> Self {
        self.inference_trace.push(line.into());
        self
    }

    /// Add an inferred fact.
    pub fn with_fact(mut self, fact: Fact) -> Self {
        self.facts.push(fact);
        self
    }
}

