// ============================================================================
// TESTS (compile-time stubs)
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_breed_id_enum() {
        assert_eq!(BreedId::ALL.len(), {{ breed_list | length }});
    }

    #[test]
    fn test_breed_from_name() {
        let breeds = [
{%- for breed in breed_list %}
            ("{{ breed | lower }}", BreedId::{{ breed | pascal_case }}),
{%- endfor %}
        ];
        for (name, expected) in &breeds {
            assert_eq!(BreedId::from_name(name), Some(*expected));
        }
    }

    #[test]
    fn test_candidate_lifecycle() {
        let mut c = Candidate::new("test".to_string(), 0.75);
        assert!(!c.eliminated);

        c = c.eliminate("too slow".to_string());
        assert!(c.eliminated);
        assert_eq!(c.elimination_reason.as_ref().unwrap(), "too slow");
    }

    #[test]
    fn test_fact_creation() {
        let f = Fact::new("color", "red");
        assert_eq!(f.key, "color");
        assert_eq!(f.value, "red");
        assert_eq!(f.to_string(), "color=red");
    }

    #[test]
    fn test_breed_output_builder() {
        let mut output = BreedOutput::new(BreedId::Prolog, "test explanation".to_string());
        output = output
            .with_selected(Candidate::new("solution".to_string(), 0.95))
            .trace("step 1: load rules".to_string())
            .trace("step 2: unify with facts".to_string())
            .with_fact(Fact::new("conclusion", "valid"));

        assert_eq!(output.breed, BreedId::Prolog);
        assert_eq!(output.inference_trace.len(), 2);
        assert_eq!(output.facts.len(), 1);
        assert!(output.selected.is_some());
    }
}
