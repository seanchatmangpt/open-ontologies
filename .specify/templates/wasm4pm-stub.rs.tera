// Module: POWL Arena — Multi-Model Storage
// ============================================================================

/// POWL arena allocator for efficient multi-model storage.
///
/// Stores multiple POWL models with metadata and provides lookup/routing.
pub mod powl_arena {
    use super::powl_models::*;
    use super::*;
    use std::collections::HashMap;

    /// Metadata for a registered POWL model.
    #[derive(Debug, Clone, Serialize, Deserialize)]
    pub struct ModelMetadata {
        /// Model identifier.
        pub model_id: String,
        /// Model name.
        pub name: String,
        /// Creation timestamp (RFC 3339).
        pub created_at: String,
        /// Version identifier.
        pub version: String,
        /// Number of transitions.
        pub transition_count: usize,
        /// Number of places.
        pub place_count: usize,
    }

    /// Registry of POWL models with metadata.
    #[derive(Debug, Clone, Serialize, Deserialize)]
    pub struct ModelRegistry {
        /// Registered models by ID.
        pub models: HashMap<String, PowlModel>,
        /// Metadata for registered models.
        pub metadata: HashMap<String, ModelMetadata>,
    }

    impl ModelRegistry {
        /// Create an empty model registry.
        pub fn new() -> Self {
            Self {
                models: HashMap::new(),
                metadata: HashMap::new(),
            }
        }

        /// Register a POWL model.
        pub fn register(&mut self, model: PowlModel) {
            let id = model.id.clone();
            let transition_count = model.transitions.len();
            let place_count = model.places.len();
            let name = model.name.clone();

            self.metadata.insert(
                id.clone(),
                ModelMetadata {
                    model_id: id.clone(),
                    name,
                    created_at: "2026-06-01T00:00:00Z".to_string(),
                    version: "1.0.0".to_string(),
                    transition_count,
                    place_count,
                },
            );
            self.models.insert(id, model);
        }

        /// Retrieve a model by ID.
        pub fn get(&self, id: &str) -> Option<&PowlModel> {
            self.models.get(id)
        }

        /// Get mutable reference to a model.
        pub fn get_mut(&mut self, id: &str) -> Option<&mut PowlModel> {
            self.models.get_mut(id)
        }

        /// List all registered model IDs.
        pub fn list_ids(&self) -> Vec<String> {
            self.models.keys().cloned().collect()
        }

        /// Get metadata for a model.
        pub fn get_metadata(&self, id: &str) -> Option<&ModelMetadata> {
            self.metadata.get(id)
        }

        /// Total number of registered models.
        pub fn count(&self) -> usize {
            self.models.len()
        }

        /// Check if a model is registered.
        pub fn contains(&self, id: &str) -> bool {
            self.models.contains_key(id)
        }
    }

    impl Default for ModelRegistry {
        fn default() -> Self {
            Self::new()
        }
    }
}

// ============================================================================
// Module: POWL Parser — Parse Formats to POWL
// ============================================================================

/// POWL format parser for PNML and other model representations.
///
/// Parses Petri net definitions from PNML, JSON, and other formats
/// into POWL model structures.
pub mod powl_parser {
    use super::powl_models::*;
    use super::*;

    /// Supported model formats.
    #[derive(Debug, Clone, Copy, Serialize, Deserialize, PartialEq, Eq)]
    pub enum ModelFormat {
        /// PNML (Petri Net Markup Language).
        #[serde(rename = "pnml")]
        Pnml,
        /// XES event log format.
        #[serde(rename = "xes")]
        Xes,
        /// POWL JSON representation.
        #[serde(rename = "powl_json")]
        PowlJson,
        /// Native Rust struct (no parsing needed).
        #[serde(rename = "powl_rust")]
        PowlRust,
    }

    /// Parser error.
    #[derive(Debug, Clone, Serialize, Deserialize)]
    pub struct ParseError {
        /// Error message.
        pub message: String,
        /// Line number (if applicable).
        pub line: Option<usize>,
        /// Column number (if applicable).
        pub column: Option<usize>,
    }

    impl fmt::Display for ParseError {
        fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
            if let Some(line) = self.line {
                write!(f, "Parse error at line {}: {}", line, self.message)
            } else {
                write!(f, "Parse error: {}", self.message)
            }
        }
    }

    impl std::error::Error for ParseError {}

    /// Parse POWL model from source string.
    ///
    /// # Arguments
    /// * `source` - Model source code
    /// * `format` - Format specifier
    ///
    /// # Returns
    /// PowlModel or ParseError
    pub fn parse(source: &str, format: ModelFormat) -> Result<PowlModel, ParseError> {
        match format {
            ModelFormat::Pnml => parse_pnml(source),
            ModelFormat::Xes => Err(ParseError {
                message: "XES format requires EventLog parser".to_string(),
                line: None,
                column: None,
            }),
            ModelFormat::PowlJson => parse_powl_json(source),
            ModelFormat::PowlRust => Err(ParseError {
                message: "PowlRust requires direct struct construction".to_string(),
                line: None,
                column: None,
            }),
        }
    }

    /// Parse PNML (Petri Net Markup Language).
    pub fn parse_pnml(source: &str) -> Result<PowlModel, ParseError> {
        if source.contains("<net") && source.contains("</net>") {
            Ok(PowlModel::new("pnml_model", "Parsed from PNML"))
        } else {
            Err(ParseError {
                message: "Invalid PNML: missing <net> tags".to_string(),
                line: Some(1),
                column: None,
            })
        }
    }

    /// Parse POWL JSON.
    pub fn parse_powl_json(source: &str) -> Result<PowlModel, ParseError> {
        if let Ok(_val) = serde_json::from_str::<serde_json::Value>(source) {
            Ok(PowlModel::new("json_model", "Parsed from JSON"))
        } else {
            Err(ParseError {
                message: "Invalid POWL JSON: malformed structure".to_string(),
                line: None,
                column: None,
            })
        }
    }
}

// ============================================================================
// Module: POWL Event Log — OCEL Structures
// ============================================================================

/// POWL event log module with Object-Centric Event Log (OCEL) support.
///
/// Provides structures for event traces, objects, and log operations
/// compatible with pm4py and process mining standards.
pub mod powl_event_log {
    use super::*;
    use std::collections::HashMap;

    /// A single event in an OCEL.
    #[derive(Debug, Clone, Serialize, Deserialize)]
    pub struct OcelEvent {
        /// Unique event identifier.
        pub id: String,
        /// Activity name.
        pub activity: String,
        /// Timestamp (ISO 8601).
        pub timestamp: String,
        /// Resource executing the event (optional).
        pub resource: Option<String>,
        /// Object IDs involved in this event.
        pub objects: Vec<String>,
        /// Custom attributes.
        pub attributes: HashMap<String, serde_json::Value>,
    }

    impl OcelEvent {
        /// Create a new event.
        pub fn new(id: impl Into<String>, activity: impl Into<String>, timestamp: impl Into<String>) -> Self {
            Self {
                id: id.into(),
                activity: activity.into(),
                timestamp: timestamp.into(),
                resource: None,
                objects: vec![],
                attributes: HashMap::new(),
            }
        }

        /// Add an involved object.
        pub fn with_object(mut self, object_id: impl Into<String>) -> Self {
            self.objects.push(object_id.into());
            self
        }

        /// Set resource.
        pub fn with_resource(mut self, resource: impl Into<String>) -> Self {
            self.resource = Some(resource.into());
            self
        }

        /// Add attribute.
        pub fn with_attribute(mut self, key: impl Into<String>, value: serde_json::Value) -> Self {
            self.attributes.insert(key.into(), value);
            self
        }
    }

    /// An object in an OCEL (e.g., order, item, resource).
    #[derive(Debug, Clone, Serialize, Deserialize)]
    pub struct OcelObject {
        /// Unique object identifier.
        pub id: String,
        /// Object type (e.g., "order", "item", "resource").
        pub object_type: String,
        /// Current lifecycle state.
        pub state: Option<String>,
    }

    impl OcelObject {
        /// Create a new object.
        pub fn new(id: impl Into<String>, object_type: impl Into<String>) -> Self {
            Self {
                id: id.into(),
                object_type: object_type.into(),
                state: None,
            }
        }

        /// Set state.
        pub fn with_state(mut self, state: impl Into<String>) -> Self {
            self.state = Some(state.into());
            self
        }
    }

    /// Object-Centric Event Log.
    #[derive(Debug, Clone, Serialize, Deserialize)]
    pub struct EventLog {
        /// Log identifier.
        pub id: String,
        /// Log name.
        pub name: String,
        /// All events.
        pub events: Vec<OcelEvent>,
        /// All objects.
        pub objects: HashMap<String, OcelObject>,
        /// Ordered event traces.
        pub traces: Vec<Vec<String>>,
    }

    impl EventLog {
        /// Create a new event log.
        pub fn new(id: impl Into<String>, name: impl Into<String>) -> Self {
            Self {
                id: id.into(),
                name: name.into(),
                events: vec![],
                objects: HashMap::new(),
                traces: vec![],
            }
        }

        /// Add an event to the log.
        pub fn add_event(&mut self, event: OcelEvent) {
            self.events.push(event);
        }

        /// Add an object to the log.
        pub fn add_object(&mut self, object: OcelObject) {
            self.objects.insert(object.id.clone(), object);
        }

        /// Get events in a specific trace.
        pub fn get_trace(&self, trace_idx: usize) -> Option<&Vec<String>> {
            self.traces.get(trace_idx)
        }

        /// Get event by ID.
        pub fn get_event(&self, event_id: &str) -> Option<&OcelEvent> {
            self.events.iter().find(|e| e.id == event_id)
        }

        /// Get object by ID.
        pub fn get_object(&self, object_id: &str) -> Option<&OcelObject> {
            self.objects.get(object_id)
        }

        /// Reconstruct trace events from event IDs.
        pub fn trace_events(&self, event_ids: &[String]) -> Vec<OcelEvent> {
            event_ids
                .iter()
                .filter_map(|id| self.get_event(id).cloned())
                .collect()
        }

        /// Get total number of events.
        pub fn event_count(&self) -> usize {
            self.events.len()
        }

        /// Get total number of objects.
        pub fn object_count(&self) -> usize {
            self.objects.len()
        }

        /// Get number of traces.
        pub fn trace_count(&self) -> usize {
            self.traces.len()
        }
    }

    impl Default for EventLog {
        fn default() -> Self {
            Self::new("default_log", "Default Event Log")
        }
    }

    /// Parse XES (eXtensible Event Stream) format.
    pub fn parse_xes(source: &str) -> Result<EventLog, String> {
        if source.contains("<log") {
            Ok(EventLog::new("xes_log", "Parsed from XES"))
        } else {
            Err("Invalid XES: missing <log> tag".to_string())
        }
    }

    /// Serialize EventLog to JSON.
    pub fn to_json(log: &EventLog) -> Result<String, serde_json::Error> {
        serde_json::to_string_pretty(log)
    }

    /// Deserialize EventLog from JSON.
    pub fn from_json(json: &str) -> Result<EventLog, serde_json::Error> {
        serde_json::from_str(json)
    }
}

// ============================================================================
// Module: Models — Process Discovery, Conformance, and Fitness
// ============================================================================

/// Process mining models: discovery, conformance, and fitness evaluation.
///
/// This module provides types and operations for:
/// - Process discovery: discovering process models from event logs
/// - Conformance checking: comparing observed behavior against declared models
/// - Fitness calculation: measuring how well a log fits a model
pub mod models {
    use super::arena::*;
    use super::powl::*;
    use super::*;

    /// Precision score type (0.0 to 1.0).
    pub type Precision = f64;
    /// Recall score type (0.0 to 1.0).
    pub type Recall = f64;
    /// F1 score type (0.0 to 1.0).
    pub type F1Score = f64;

    /// Conformance evaluation result.
    #[derive(Debug, Clone, Serialize, Deserialize)]
    pub struct ConformanceReport {
        /// Model ID being checked.
        pub model_id: String,
        /// Log ID being checked.
        pub log_id: String,
        /// Fitness: how well the log replays through the model.
        pub fitness: f64,
        /// Precision: how many model behaviors occurred in the log.
        pub precision: f64,
        /// Recall: how many log behaviors were allowed by the model.
        pub recall: f64,
        /// F1 score: harmonic mean of precision and recall.
        pub f1_score: f64,
        /// Number of non-conforming traces.
        pub non_conforming_traces: usize,
        /// Total traces in the log.
        pub total_traces: usize,
    }

    impl ConformanceReport {
        /// Create a new conformance report.
        pub fn new(model_id: String, log_id: String) -> Self {
            Self {
                model_id,
                log_id,
                fitness: 0.0,
                precision: 0.0,
                recall: 0.0,
                f1_score: 0.0,
                non_conforming_traces: 0,
                total_traces: 0,
            }
        }

        /// Check if the model is sufficiently conforming (fitness >= threshold).
        pub fn is_conforming(&self, threshold: f64) -> bool {
            self.fitness >= threshold
        }
    }

    /// A process discovery engine.
    ///
    /// Discovers process models from OCEL event logs using variants of
    /// the Inductive Miner or Directly-Follows Graph algorithms.
    #[derive(Debug)]
    pub struct ProcessDiscovery {
        /// Discovery algorithm (e.g., "inductive-miner", "dfg").
        pub algorithm: String,
        /// Minimum support threshold (0.0 to 1.0).
        pub min_support: f64,
    }

    impl ProcessDiscovery {
        /// Create a new discovery engine with default settings.
        pub fn new() -> Self {
            Self {
                algorithm: "inductive-miner".to_string(),
                min_support: 0.01,
            }
        }

        /// Set the discovery algorithm.
        pub fn with_algorithm(mut self, algorithm: String) -> Self {
            self.algorithm = algorithm;
            self
        }

        /// Set the minimum support threshold.
        pub fn with_min_support(mut self, min_support: f64) -> Self {
            self.min_support = min_support.clamp(0.0, 1.0);
            self
        }

        /// **Stub**: Discover variants from an OCEL arena.
        pub fn discover(&self, arena: &OcelArena) -> Result<PowlVariantSet> {
            Err(Wasm4pmError {
                message: "Process discovery not yet implemented".to_string(),
                code: "E_DISCOVERY_NOT_IMPL".to_string(),
            })
        }

        /// **Stub**: Discover variants with strict conformance to AAT-Live rules.
        pub fn discover_live_conforming(&self, arena: &OcelArena, rules: &[String]) -> Result<PowlVariantSet> {
            Err(Wasm4pmError {
                message: "Live-conforming discovery not yet implemented".to_string(),
                code: "E_LIVE_DISCOVERY_NOT_IMPL".to_string(),
            })
        }
    }

    impl Default for ProcessDiscovery {
        fn default() -> Self {
            Self::new()
        }
    }

    /// A conformance checker.
    ///
    /// Compares process variants (POWL models) against event logs to compute
    /// fitness, precision, recall, and F1 scores.
    #[derive(Debug)]
    pub struct ConformanceChecker;

    impl ConformanceChecker {
        /// **Stub**: Check conformance of a POWL variant against an OCEL arena.
        pub fn check(variant: &PowlVariant, arena: &OcelArena) -> Result<ConformanceReport> {
            Err(Wasm4pmError {
                message: "Conformance checking not yet implemented".to_string(),
                code: "E_CONFORMANCE_CHECK_NOT_IMPL".to_string(),
            })
        }

        /// **Stub**: Check conformance of all variants in a set.
        pub fn check_all(variants: &PowlVariantSet, arena: &OcelArena) -> Result<Vec<ConformanceReport>> {
            Err(Wasm4pmError {
                message: "Batch conformance checking not yet implemented".to_string(),
                code: "E_BATCH_CONFORMANCE_NOT_IMPL".to_string(),
            })
        }
    }

    /// A fitness calculator for detailed trace-level analysis.
    #[derive(Debug)]
    pub struct FitnessCalculator {
        /// Whether to emit OTEL spans during calculation.
        pub emit_otel_spans: bool,
    }

    impl FitnessCalculator {
        /// Create a new fitness calculator.
        pub fn new() -> Self {
            Self {
                emit_otel_spans: true,
            }
        }

        /// **Stub**: Calculate fitness for a single trace.
        pub fn fitness_trace(&self, trace: &[String], variant: &PowlVariant) -> Result<f64> {
            Err(Wasm4pmError {
                message: "Trace fitness calculation not yet implemented".to_string(),
                code: "E_TRACE_FITNESS_NOT_IMPL".to_string(),
            })
        }

        /// **Stub**: Calculate fitness metrics with detailed diagnostics.
        pub fn fitness_detailed(&self, arena: &OcelArena, variant: &PowlVariant) -> Result<ConformanceReport> {
            Err(Wasm4pmError {
                message: "Detailed fitness calculation not yet implemented".to_string(),
                code: "E_DETAILED_FITNESS_NOT_IMPL".to_string(),
            })
        }
    }

    impl Default for FitnessCalculator {
        fn default() -> Self {
            Self::new()
        }
    }
}

// ============================================================================
// Public API
// ============================================================================

/// Re-export all submodules for convenient access.
pub use arena::OcelArena;
pub use models::{ConformanceChecker, ConformanceReport, FitnessCalculator, ProcessDiscovery};
pub use parser::OcelParser;
pub use powl::{PowlVariant, PowlVariantSet};

/// Re-export conformance checking functions from powl_conformance.
pub use powl_conformance::{replay_trace, compute_fitness, compute_aggregate_fitness, FitnessResult, TraceReplayResult};

/// Re-export POWL model structures from powl_models.
pub use powl_models::{PowlModel, Transition, Place, Arc, ArcDirection};

/// Re-export POWL arena structures from powl_arena.
pub use powl_arena::ModelRegistry;

/// Re-export POWL parser structures from powl_parser.
pub use powl_parser::{parse, ModelFormat, ParseError};

/// Re-export POWL event log structures from powl_event_log.
pub use powl_event_log::{EventLog, OcelEvent, OcelObject};

#[cfg(test)]
mod tests {
    use super::*;

    // ========== POWL Conformance Tests ==========

    #[test]
    fn test_trace_replay_result_fitness() {
        let result = TraceReplayResult::new(
            "trace_1".to_string(),
            vec!["activity_a".to_string(), "activity_b".to_string()],
        );
        let fitness = result.fitness();
        assert!(fitness >= 0.0 && fitness <= 1.0);
    }

    #[test]
    fn test_fitness_result_overall() {
        let mut result = FitnessResult::new();
        result.trace_fitness = 0.8;
        result.event_fitness = 0.9;
        assert_eq!(result.overall_fitness(), 0.85);
    }

    #[test]
    fn test_compute_fitness_empty_trace() {
        let fitness = compute_fitness(&[], "model_1");
        assert_eq!(fitness, 1.0);
    }

    #[test]
    fn test_replay_trace() {
        let trace = vec!["A".to_string(), "B".to_string(), "C".to_string()];
        let result = replay_trace(&trace, "model_1");
        assert_eq!(result.events.len(), 3);
        assert!(!result.events.is_empty());
    }

    // ========== POWL Models Tests ==========

    #[test]
    fn test_place_creation() {
        let place = powl_models::Place::new("p1", "Input Place")
            .with_initial_tokens(5);
        assert_eq!(place.id, "p1");
        assert_eq!(place.initial_tokens, 5);
    }

    #[test]
    fn test_transition_visible() {
        let trans = powl_models::Transition::new("t1", "Action", "activity_x");
        assert_eq!(trans.id, "t1");
        assert!(!trans.is_silent);
        assert_eq!(trans.event_name, Some("activity_x".to_string()));
    }

    #[test]
    fn test_transition_silent() {
        let trans = powl_models::Transition::silent("t_skip", "Skip");
        assert!(trans.is_silent);
        assert_eq!(trans.event_name, None);
    }

    #[test]
    fn test_arc_creation() {
        let arc = powl_models::Arc::new("p1", "t1", powl_models::ArcDirection::PlaceToTransition)
            .with_weight(2);
        assert_eq!(arc.weight, 2);
        assert_eq!(arc.direction, powl_models::ArcDirection::PlaceToTransition);
    }

    #[test]
    fn test_powl_model_construction() {
        let mut model = powl_models::PowlModel::new("model_1", "Test Model");
        model.add_place(powl_models::Place::new("p1", "Start"));
        model.add_transition(powl_models::Transition::new("t1", "Do", "do_action"));
        model.set_initial_marking("p1", 1);

        assert_eq!(model.transitions.len(), 1);
        assert_eq!(model.places.len(), 1);
        assert_eq!(model.initial_marking.get("p1"), Some(&1));
    }

    #[test]
    fn test_powl_model_lookup() {
        let mut model = powl_models::PowlModel::new("model_1", "Test");
        model.add_place(powl_models::Place::new("p1", "Place 1"));
        model.add_transition(powl_models::Transition::new("t1", "Trans 1", "act"));

        assert!(model.get_place("p1").is_some());
        assert!(model.get_transition("t1").is_some());
        assert!(model.get_place("p99").is_none());
    }

    // ========== POWL Arena Tests ==========

    #[test]
    fn test_model_registry_creation() {
        let registry = powl_arena::ModelRegistry::new();
        assert_eq!(registry.count(), 0);
    }

    #[test]
    fn test_model_registry_register() {
        let mut registry = powl_arena::ModelRegistry::new();
        let model = powl_models::PowlModel::new("m1", "Model 1");
        registry.register(model);

        assert_eq!(registry.count(), 1);
        assert!(registry.contains("m1"));
        assert!(registry.get("m1").is_some());
    }

    #[test]
    fn test_model_registry_list_ids() {
        let mut registry = powl_arena::ModelRegistry::new();
        let m1 = powl_models::PowlModel::new("m1", "Model 1");
        let m2 = powl_models::PowlModel::new("m2", "Model 2");
        registry.register(m1);
        registry.register(m2);

        let ids = registry.list_ids();
        assert_eq!(ids.len(), 2);
        assert!(ids.contains(&"m1".to_string()));
        assert!(ids.contains(&"m2".to_string()));
    }

    // ========== POWL Parser Tests ==========

    #[test]
    fn test_parse_pnml_valid() {
        let source = "<net><place/><transition/></net>";
        let result = powl_parser::parse_pnml(source);
        assert!(result.is_ok());
    }

    #[test]
    fn test_parse_pnml_invalid() {
        let source = "<invalid>content</invalid>";
        let result = powl_parser::parse_pnml(source);
        assert!(result.is_err());
    }

    #[test]
    fn test_parse_format_dispatch() {
        let pnml_source = "<net></net>";
        let result = powl_parser::parse(pnml_source, powl_parser::ModelFormat::Pnml);
        assert!(result.is_ok());
    }

    // ========== POWL Event Log Tests ==========

    #[test]
    fn test_ocel_event_creation() {
        let event = powl_event_log::OcelEvent::new("e1", "activity_a", "2026-06-01T10:00:00Z")
            .with_object("obj1")
            .with_resource("res1");
        assert_eq!(event.id, "e1");
        assert_eq!(event.activity, "activity_a");
        assert_eq!(event.objects.len(), 1);
        assert_eq!(event.resource, Some("res1".to_string()));
    }

    #[test]
    fn test_ocel_object_creation() {
        let obj = powl_event_log::OcelObject::new("obj1", "order")
            .with_state("pending");
        assert_eq!(obj.id, "obj1");
        assert_eq!(obj.object_type, "order");
        assert_eq!(obj.state, Some("pending".to_string()));
    }

    #[test]
    fn test_event_log_operations() {
        let mut log = powl_event_log::EventLog::new("log1", "Test Log");
        let event = powl_event_log::OcelEvent::new("e1", "activity_a", "2026-06-01T10:00:00Z");
        let obj = powl_event_log::OcelObject::new("obj1", "order");

        log.add_event(event);
        log.add_object(obj);

        assert_eq!(log.event_count(), 1);
        assert_eq!(log.object_count(), 1);
        assert!(log.get_event("e1").is_some());
        assert!(log.get_object("obj1").is_some());
    }

    #[test]
    fn test_event_log_json_roundtrip() {
        let mut log = powl_event_log::EventLog::new("log1", "Test");
        let event = powl_event_log::OcelEvent::new("e1", "act", "2026-06-01T10:00:00Z");
        log.add_event(event);

        let json = powl_event_log::to_json(&log).unwrap();
        let restored = powl_event_log::from_json(&json).unwrap();

        assert_eq!(restored.id, "log1");
        assert_eq!(restored.event_count(), 1);
    }

    // ========== Existing Tests ==========

    #[test]
    fn test_powl_variant_creation() {
        let variant = PowlVariant::new(
            "VAR-001".to_string(),
            "Main Process".to_string(),
            "<petri/>".to_string(),
        );
        assert_eq!(variant.id, "VAR-001");
        assert_eq!(variant.frequency, 0);
    }

    #[test]
    fn test_arena_capacity() {
        let arena = arena::OcelArena::with_capacity(100);
        assert!(arena.is_empty());
        assert_eq!(arena.len(), 0);
    }

    #[test]
    fn test_parser_config() {
        let config = parser::ParserConfig::default();
        assert_eq!(config.schema_version, "2.0");
        assert!(config.validate_timestamps);
    }

    #[test]
    fn test_process_discovery() {
        let discovery = ProcessDiscovery::new();
        assert_eq!(discovery.algorithm, "inductive-miner");
        assert!(discovery.min_support >= 0.0 && discovery.min_support <= 1.0);
    }

    #[test]
    fn test_conformance_report() {
        let report = ConformanceReport::new("model-1".to_string(), "log-1".to_string());
        assert!(!report.is_conforming(0.1));
    }
}
