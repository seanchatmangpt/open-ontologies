use serde::{Deserialize, Serialize};
use std::error::Error;
use std::fmt;

// ============================================================================
// Error Types
// ============================================================================

/// Wasm4pm operation error.
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct Wasm4pmError {
    /// Error message.
    pub message: String,
    /// Error code (for machine-readable handling).
    pub code: String,
}

impl fmt::Display for Wasm4pmError {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        write!(f, "{} ({})", self.message, self.code)
    }
}

impl Error for Wasm4pmError {}

/// Result type for wasm4pm operations.
pub type Result<T> = std::result::Result<T, Wasm4pmError>;

// ============================================================================
// Module: POWL — Process POWL Variant Definitions
// ============================================================================

/// POWL (Partially Ordered Workflow Language) variant definitions.
///
/// POWL is used to represent process models discovered from event logs or
/// declared in process specifications. This module handles POWL variant
/// definitions, including sequential, parallel, choice, and loop constructs.
pub mod powl {
    use super::*;

    /// A POWL variant — a unique discovered or declared process model.
    ///
    /// Each variant has a unique ID, a formal POWL definition (as a string
    /// or tree), and conformance metrics that compare the variant against
    /// reference process definitions.
    #[derive(Debug, Clone, Serialize, Deserialize)]
    pub struct PowlVariant {
        /// Unique identifier for this variant (e.g., "VARIANT-001").
        pub id: String,
        /// Human-readable name.
        pub name: String,
        /// POWL definition in Petri net XML or JSON format.
        pub definition: String,
        /// Frequency: how many case executions follow this variant.
        pub frequency: usize,
        /// Conformance score: how well this variant matches the reference model.
        pub conformance_score: f64,
    }

    impl PowlVariant {
        /// Create a new POWL variant.
        pub fn new(id: String, name: String, definition: String) -> Self {
            Self {
                id,
                name,
                definition,
                frequency: 0,
                conformance_score: 0.0,
            }
        }

        /// Set the frequency (case count) for this variant.
        pub fn with_frequency(mut self, frequency: usize) -> Self {
            self.frequency = frequency;
            self
        }

        /// Set the conformance score.
        pub fn with_conformance_score(mut self, score: f64) -> Self {
            self.conformance_score = score.clamp(0.0, 1.0);
            self
        }

        /// Parse POWL definition and validate syntax.
        ///
        /// **Stub**: Returns Err indicating not yet implemented.
        pub fn validate(&self) -> Result<()> {
            Err(Wasm4pmError {
                message: "POWL validation not yet implemented".to_string(),
                code: "E_POWL_VALIDATE_NOT_IMPL".to_string(),
            })
        }

        /// Check if this variant satisfies a given AAT-Live conformance rule.
        ///
        /// **Stub**: Returns Err indicating not yet implemented.
        pub fn satisfies_live_rule(&self, rule_id: &str) -> Result<bool> {
            Err(Wasm4pmError {
                message: format!("Live rule conformance check not yet implemented for {}", rule_id),
                code: "E_LIVE_RULE_CHECK_NOT_IMPL".to_string(),
            })
        }
    }

    /// A set of POWL variants representing process diversity.
    #[derive(Debug, Clone, Serialize, Deserialize)]
    pub struct PowlVariantSet {
        /// Variants in this set.
        pub variants: Vec<PowlVariant>,
    }

    impl PowlVariantSet {
        /// Create a new empty variant set.
        pub fn new() -> Self {
            Self {
                variants: Vec::new(),
            }
        }

        /// Add a variant to the set.
        pub fn add_variant(&mut self, variant: PowlVariant) {
            self.variants.push(variant);
        }

        /// Get the most frequent variant.
        pub fn most_frequent(&self) -> Option<&PowlVariant> {
            self.variants.iter().max_by_key(|v| v.frequency)
        }

        /// Filter variants by minimum conformance score.
        pub fn conforming_variants(&self, min_score: f64) -> Vec<&PowlVariant> {
            self.variants
                .iter()
                .filter(|v| v.conformance_score >= min_score)
                .collect()
        }
    }

    impl Default for PowlVariantSet {
        fn default() -> Self {
            Self::new()
        }
    }
}

// ============================================================================
// Module: Arena — Compact Arena Allocator for OCEL Event Logs
// ============================================================================

/// Arena allocator for memory-efficient OCEL event log storage.
///
/// OCEL (Object-Centric Event Logs) can be very large. This module provides
/// a compact, pre-allocated arena that stores events, objects, and attributes
/// without per-allocation overhead.
pub mod arena {
    use super::*;

    /// A single event in the OCEL log.
    #[derive(Debug, Clone, Serialize, Deserialize)]
    pub struct Event {
        /// Unique event ID.
        pub event_id: String,
        /// Event activity name.
        pub activity: String,
        /// Timestamp (ISO 8601 format).
        pub timestamp: String,
        /// Object IDs involved in this event.
        pub involved_objects: Vec<String>,
        /// Event attributes (key-value pairs).
        pub attributes: Vec<(String, serde_json::Value)>,
    }

    impl Event {
        /// Create a new event.
        pub fn new(event_id: String, activity: String, timestamp: String) -> Self {
            Self {
                event_id,
                activity,
                timestamp,
                involved_objects: Vec::new(),
                attributes: Vec::new(),
            }
        }

        /// Add an involved object.
        pub fn with_object(mut self, object_id: String) -> Self {
            self.involved_objects.push(object_id);
            self
        }

        /// Add an attribute.
        pub fn with_attribute(mut self, key: String, value: serde_json::Value) -> Self {
            self.attributes.push((key, value));
            self
        }
    }

    /// A compact arena for storing OCEL events and related data.
    #[derive(Debug, Clone, Serialize, Deserialize)]
    pub struct OcelArena {
        /// All events in the log, stored contiguously.
        pub events: Vec<Event>,
        /// Total byte size of all stored data.
        pub total_bytes: usize,
    }

    impl OcelArena {
        /// Create a new arena with an estimated capacity.
        pub fn with_capacity(capacity: usize) -> Self {
            Self {
                events: Vec::with_capacity(capacity),
                total_bytes: 0,
            }
        }

        /// Add an event to the arena.
        pub fn push_event(&mut self, event: Event) {
            self.total_bytes += event.event_id.len() + event.activity.len() + event.timestamp.len();
            self.events.push(event);
        }

        /// Get the number of events in the arena.
        pub fn len(&self) -> usize {
            self.events.len()
        }

        /// Check if the arena is empty.
        pub fn is_empty(&self) -> bool {
            self.events.is_empty()
        }

        /// Iterate over events.
        pub fn iter(&self) -> impl Iterator<Item = &Event> {
            self.events.iter()
        }

        /// Memory usage in bytes.
        pub fn memory_usage(&self) -> usize {
            self.total_bytes
        }

        /// **Stub**: Compact the arena (defragment).
        pub fn compact(&mut self) -> Result<()> {
            Err(Wasm4pmError {
                message: "Arena compaction not yet implemented".to_string(),
                code: "E_ARENA_COMPACT_NOT_IMPL".to_string(),
            })
        }

        /// **Stub**: Serialize arena to binary format for WASM transmission.
        pub fn to_wasm_binary(&self) -> Result<Vec<u8>> {
            Err(Wasm4pmError {
                message: "WASM binary serialization not yet implemented".to_string(),
                code: "E_WASM_BINARY_NOT_IMPL".to_string(),
            })
        }

        /// **Stub**: Deserialize arena from binary format.
        pub fn from_wasm_binary(data: &[u8]) -> Result<Self> {
            Err(Wasm4pmError {
                message: "WASM binary deserialization not yet implemented".to_string(),
                code: "E_WASM_BINARY_DESER_NOT_IMPL".to_string(),
            })
        }
    }

    impl Default for OcelArena {
        fn default() -> Self {
            Self {
                events: Vec::new(),
                total_bytes: 0,
            }
        }
    }
}

