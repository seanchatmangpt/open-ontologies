/// Petri net representation of a POWL model.
/// Places: process activities and intermediate states.
/// Transitions: process steps that advance marking.
/// Arcs: flow between places and transitions.
#[derive(Debug, Clone)]
pub struct PowlPetriNet {
    /// Unique place identifiers
    pub places: HashSet<String>,
    /// Unique transition identifiers
    pub transitions: HashSet<String>,
    /// Flow arcs: (from, to) pairs
    pub arcs: Vec<(String, String)>,
    /// Pre-condition: places that feed this transition
    pub pre: HashMap<String, HashSet<String>>,
    /// Post-condition: places that follow this transition
    pub post: HashMap<String, HashSet<String>>,
}

impl PowlPetriNet {
    /// Create an empty Petri net.
    pub fn new() -> Self {
        Self {
            places: HashSet::new(),
            transitions: HashSet::new(),
            arcs: Vec::new(),
            pre: HashMap::new(),
            post: HashMap::new(),
        }
    }

    /// Add a place to the Petri net.
    pub fn add_place(&mut self, place_id: impl Into<String>) {
        self.places.insert(place_id.into());
    }

    /// Add a transition to the Petri net.
    pub fn add_transition(&mut self, transition_id: impl Into<String>) {
        self.transitions.insert(transition_id.into());
    }

    /// Add an arc (place → transition or transition → place).
    pub fn add_arc(&mut self, from: impl Into<String>, to: impl Into<String>) {
        let from_str = from.into();
        let to_str = to.into();
        self.arcs.push((from_str.clone(), to_str.clone()));

        // Update pre/post caches
        if self.places.contains(&from_str) && self.transitions.contains(&to_str) {
            // Place → Transition
            self.post
                .entry(from_str)
                .or_insert_with(HashSet::new)
                .insert(to_str.clone());
            self.pre
                .entry(to_str)
                .or_insert_with(HashSet::new)
                .insert(from_str);
        } else if self.transitions.contains(&from_str) && self.places.contains(&to_str) {
            // Transition → Place
            self.post
                .entry(from_str)
                .or_insert_with(HashSet::new)
                .insert(to_str.clone());
            self.pre
                .entry(to_str)
                .or_insert_with(HashSet::new)
                .insert(from_str);
        }
    }
}

impl Default for PowlPetriNet {
    fn default() -> Self {
        Self::new()
    }
}

/// Initial and final marking states for Petri net replay.
/// A marking is a distribution of tokens across places.
#[derive(Debug, Clone)]
pub struct PowlMarking {
    /// Tokens per place: place_id → token_count
    pub tokens: HashMap<String, usize>,
}

impl PowlMarking {
    /// Create a new empty marking.
    pub fn new() -> Self {
        Self {
            tokens: HashMap::new(),
        }
    }

    /// Set token count for a place.
    pub fn set(&mut self, place_id: impl Into<String>, count: usize) {
        self.tokens.insert(place_id.into(), count);
    }

    /// Get token count for a place (default 0 if absent).
    pub fn get(&self, place_id: &str) -> usize {
        self.tokens.get(place_id).copied().unwrap_or(0)
    }

    /// Add token to a place.
    pub fn add(&mut self, place_id: impl Into<String>, count: usize) {
        let place = place_id.into();
        *self.tokens.entry(place).or_insert(0) += count;
    }

    /// Remove token from a place (if possible).
    pub fn remove(&mut self, place_id: &str, count: usize) -> Result<(), String> {
        let current = self.get(place_id);
        if current >= count {
            self.tokens.insert(place_id.to_string(), current - count);
            Ok(())
        } else {
            Err(format!(
                "Cannot remove {} tokens from place {}: only {} available",
                count, place_id, current
            ))
        }
    }

    /// Clone this marking.
    pub fn clone_marking(&self) -> Self {
        Self {
            tokens: self.tokens.clone(),
        }
    }
}

impl Default for PowlMarking {
    fn default() -> Self {
        Self::new()
    }
}

// ============================================================================
// TOKEN REPLAY RESULTS
// ============================================================================

/// Result of replaying a single trace against a Petri net.
/// Tracks token flow: produced, consumed, missing, remaining.
#[derive(Debug, Clone)]
pub struct TraceReplayResult {
    /// Case identifier replayed
    pub case_id: String,
    /// Trace fitness score (0.0 to 1.0)
    pub fitness: f64,
    /// Tokens produced (arcs consumed): count
    pub produced_tokens: usize,
    /// Tokens consumed (arcs enabled): count
    pub consumed_tokens: usize,
    /// Tokens missing (events that cannot fire): count
    pub missing_tokens: usize,
    /// Tokens remaining (not consumed at end): count
    pub remaining_tokens: usize,
    /// Whether the trace replayed successfully (fitness == 1.0)
    pub is_perfect: bool,
    /// Event sequence that was replayed
    pub event_sequence: Vec<String>,
}

impl TraceReplayResult {
    /// Create a new trace replay result.
    pub fn new(case_id: impl Into<String>) -> Self {
        Self {
            case_id: case_id.into(),
            fitness: 0.0,
            produced_tokens: 0,
            consumed_tokens: 0,
            missing_tokens: 0,
            remaining_tokens: 0,
            is_perfect: false,
            event_sequence: Vec::new(),
        }
    }

    /// Compute fitness from token counts.
    /// Formula: fitness = (2 * consumed) / (produced + consumed + missing + remaining)
    pub fn compute_fitness(&mut self) {
        let total = self.produced_tokens as f64
            + self.consumed_tokens as f64
            + self.missing_tokens as f64
            + self.remaining_tokens as f64;
        if total > 0.0 {
            self.fitness = (2.0 * self.consumed_tokens as f64) / total;
        } else {
            self.fitness = 1.0;
        }
        self.is_perfect = (self.fitness - 1.0).abs() < 1e-9;
    }

    /// Add event to the sequence being replayed.
    pub fn add_event(&mut self, event_name: impl Into<String>) {
        self.event_sequence.push(event_name.into());
    }
}

/// Aggregate fitness score over an entire event log.
/// Averages fitness across all traces and tracks overall alignment.
#[derive(Debug, Clone)]
pub struct FitnessResult {
    /// Average fitness across all traces
    pub avg_fitness: f64,
    /// Minimum fitness observed
    pub min_fitness: f64,
    /// Maximum fitness observed
    pub max_fitness: f64,
    /// Number of traces replayed
    pub trace_count: usize,
    /// Number of perfect traces (fitness == 1.0)
    pub perfect_traces: usize,
    /// Per-trace results (optional detailed breakdown)
    pub traces: Vec<TraceReplayResult>,
}

impl FitnessResult {
    /// Create a new fitness result.
    pub fn new() -> Self {
        Self {
            avg_fitness: 0.0,
            min_fitness: 1.0,
            max_fitness: 0.0,
            trace_count: 0,
            perfect_traces: 0,
            traces: Vec::new(),
        }
    }

    /// Add a trace replay result to the fitness aggregation.
    pub fn add_trace_result(&mut self, result: TraceReplayResult) {
        if result.is_perfect {
            self.perfect_traces += 1;
        }
        self.min_fitness = self.min_fitness.min(result.fitness);
        self.max_fitness = self.max_fitness.max(result.fitness);
        self.traces.push(result);
        self.trace_count += 1;
    }

    /// Compute aggregate fitness from collected traces.
    pub fn compute_aggregate(&mut self) {
        if self.trace_count > 0 {
            let sum: f64 = self.traces.iter().map(|t| t.fitness).sum();
            self.avg_fitness = sum / self.trace_count as f64;
        } else {
            self.avg_fitness = 1.0;
        }
    }
}

impl Default for FitnessResult {
    fn default() -> Self {
        Self::new()
    }
}

// ============================================================================
// TOKEN REPLAY ENGINE
// ============================================================================

/// Token replay conformance checking for Petri nets.
/// Implements the classic replay algorithm: for each trace, fire transitions
/// corresponding to events and count produced, consumed, missing, and remaining tokens.
pub mod conformance {
    use super::*;

    /// Replay a single trace against a Petri net model.
    ///
    /// Algorithm:
    ///   1. For each event in the trace, find transitions labeled with that event
    ///   2. Check if the transition is enabled (all pre-places have tokens)
    ///   3. If enabled, consume tokens from pre-places and produce to post-places
    ///   4. If not enabled, increment missing tokens counter
    ///   5. At the end, count remaining tokens
    ///
    /// Returns TraceReplayResult with fitness, token counts, and event sequence.
    {%- for item_name in item_name_list %}
    {%- if "replay_trace" in item_name %}
    pub fn replay_trace(
        model: &PowlPetriNet,
        initial_marking: &PowlMarking,
        final_marking: &PowlMarking,
        trace: &Trace,
    ) -> Result<TraceReplayResult, String> {
        let span = span!(Level::DEBUG, "powl.replay.execute");
        let _guard = span.enter();

        let mut result = TraceReplayResult::new(trace.case_id.clone());
        let mut current_marking = initial_marking.clone_marking();

        // Replay each event in the trace
        for event in &trace.events {
            result.add_event(&event.name);

            // Find transition(s) matching this event name
            let matching_transitions: Vec<_> = model
                .transitions
                .iter()
                .filter(|t| t.contains(&event.name) || event.name.contains(t.as_str()))
                .collect();

            if matching_transitions.is_empty() {
                // No matching transition — missing token
                result.missing_tokens += 1;
                continue;
            }

            let mut fired = false;
            for transition in &matching_transitions {
                // Check if transition is enabled
                let preconditions = model.pre.get(transition.as_str()).unwrap_or(&HashSet::new());
                let mut can_fire = true;
                for pre_place in preconditions {
                    if current_marking.get(pre_place) == 0 {
                        can_fire = false;
                        break;
                    }
                }

                if can_fire {
                    // Fire the transition
                    for pre_place in preconditions {
                        current_marking.remove(pre_place, 1)?;
                        result.consumed_tokens += 1;
                    }

                    let postconditions = model.post.get(transition.as_str()).unwrap_or(&HashSet::new());
                    for post_place in postconditions {
                        current_marking.add(post_place, 1);
                        result.produced_tokens += 1;
                    }

                    fired = true;
                    break;
                }
            }

            if !fired {
                result.missing_tokens += 1;
            }
        }

        // Count remaining tokens (not consumed)
        for (place, tokens) in &current_marking.tokens {
            if !final_marking.tokens.contains_key(place.as_str()) {
                result.remaining_tokens += *tokens;
            }
        }

        // Compute fitness
        result.compute_fitness();

        Ok(result)
    }
    {%- endif %}
    {%- endfor %}

    /// Compute aggregate fitness over an entire event log.
    ///
    /// Re-replays all traces and aggregates fitness metrics.
    /// Returns FitnessResult with average, min, max fitness and perfect trace count.
    {%- for item_name in item_name_list %}
    {%- if "compute_fitness" in item_name %}
    pub fn compute_fitness(
        model: &PowlPetriNet,
        initial_marking: &PowlMarking,
        final_marking: &PowlMarking,
        log: &EventLog,
    ) -> Result<FitnessResult, String> {
        let span = span!(Level::DEBUG, "powl.fitness.compute");
        let _guard = span.enter();

        let mut fitness_result = FitnessResult::new();

        for trace in &log.traces {
            let trace_result = replay_trace(model, initial_marking, final_marking, trace)?;
            fitness_result.add_trace_result(trace_result);
        }

        fitness_result.compute_aggregate();

        Ok(fitness_result)
    }
    {%- endif %}
    {%- endfor %}

    /// Check if trace fitness aligns with event-log patterns.
    ///
    /// Validates that the given trace's fitness is consistent with the broader
    /// event log's fitness distribution. A trace is considered "aligned" if its
    /// fitness is within acceptable deviation from the average.
    ///
    /// Parameters:
    ///   - log: Full event log for pattern reference
    ///   - trace: Trace to check alignment for
    ///   - threshold: Acceptable fitness threshold (0.0 to 1.0)
    ///
    /// Returns true if the trace is aligned (fitness >= threshold).
    {%- for item_name in item_name_list %}
    {%- if "check_conformance_alignment" in item_name %}
    pub fn check_conformance_alignment(
        log: &EventLog,
        trace: &Trace,
        threshold: f64,
    ) -> Result<bool, String> {
        let span = span!(Level::DEBUG, "algos.conformance.align");
        let _guard = span.enter();

        if log.traces.is_empty() {
            return Err("Event log is empty".to_string());
        }

        if trace.events.is_empty() {
            return Err("Trace is empty".to_string());
        }

        if !(0.0..=1.0).contains(&threshold) {
            return Err(format!("Threshold must be between 0.0 and 1.0, got {}", threshold));
        }

        // Find traces with similar event count (pattern proxy)
        let trace_event_count = trace.events.len() as f64;
        let mut similar_traces = Vec::new();

        for log_trace in &log.traces {
            let log_trace_event_count = log_trace.events.len() as f64;
            // Similar if within ±50% event count
            if (log_trace_event_count / trace_event_count).abs() < 1.5
                && (log_trace_event_count / trace_event_count).abs() > 0.67
            {
                similar_traces.push(log_trace);
            }
        }

        if similar_traces.is_empty() {
            // No similar pattern found; accept by default
            return Ok(true);
        }

        // Compute average event diversity in similar traces
        let avg_diversity: f64 = similar_traces
            .iter()
            .map(|t| t.events.len() as f64)
            .sum::<f64>()
            / similar_traces.len() as f64;

        // Check if this trace's event diversity is aligned
        let alignment = trace.events.len() as f64 / avg_diversity;
        Ok(alignment >= threshold)
    }
    {%- endif %}
    {%- endfor %}
}

// ============================================================================
// INSTRUMENTATION & DIAGNOSTICS
// ============================================================================

/// Trace and describe the state of the Petri net at each step.
pub fn diagnose_marking(marking: &PowlMarking) -> String {
    let mut parts = Vec::new();
    for (place, tokens) in &marking.tokens {
        if *tokens > 0 {
            parts.push(format!("{}={}", place, tokens));
        }
    }
    if parts.is_empty() {
        "[empty]".to_string()
    } else {
        format!("[{}]", parts.join(", "))
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_petri_net_creation() {
        let mut net = PowlPetriNet::new();
        net.add_place("p1");
        net.add_transition("t1");
        net.add_arc("p1", "t1");

        assert!(net.places.contains("p1"));
        assert!(net.transitions.contains("t1"));
        assert_eq!(net.arcs.len(), 1);
    }

    #[test]
    fn test_marking_operations() {
        let mut marking = PowlMarking::new();
        marking.set("p1", 2);
        assert_eq!(marking.get("p1"), 2);

        marking.add("p1", 1);
        assert_eq!(marking.get("p1"), 3);

        let result = marking.remove("p1", 2);
        assert!(result.is_ok());
        assert_eq!(marking.get("p1"), 1);

        let result = marking.remove("p1", 5);
        assert!(result.is_err());
    }

    #[test]
    fn test_trace_replay_result() {
        let mut result = TraceReplayResult::new("case_1");
        result.produced_tokens = 10;
        result.consumed_tokens = 8;
        result.missing_tokens = 2;
        result.remaining_tokens = 0;
        result.compute_fitness();

        // fitness = (2 * 8) / (10 + 8 + 2 + 0) = 16 / 20 = 0.8
        assert!((result.fitness - 0.8).abs() < 1e-9);
    }

    #[test]
    fn test_fitness_result_aggregation() {
        let mut fitness = FitnessResult::new();

        let mut result1 = TraceReplayResult::new("case_1");
        result1.fitness = 1.0;
        result1.is_perfect = true;
        fitness.add_trace_result(result1);

        let mut result2 = TraceReplayResult::new("case_2");
        result2.fitness = 0.6;
        result2.is_perfect = false;
        fitness.add_trace_result(result2);

        fitness.compute_aggregate();

        assert_eq!(fitness.trace_count, 2);
        assert_eq!(fitness.perfect_traces, 1);
        assert!((fitness.avg_fitness - 0.8).abs() < 1e-9);
        assert!((fitness.min_fitness - 0.6).abs() < 1e-9);
        assert!((fitness.max_fitness - 1.0).abs() < 1e-9);
    }
}
