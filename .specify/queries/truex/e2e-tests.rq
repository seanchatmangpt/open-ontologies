PREFIX truex: <https://open-ontologies.org/profile/truex#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?label (REPLACE(STR(?input), '"', "'") AS ?input_safe) ?expected ?reason WHERE {
  ?test a truex:E2ETest ;
        rdfs:label ?label ;
        truex:testInput ?input ;
        truex:expectedResult ?expected .
  OPTIONAL { ?test truex:refusalReason ?reason }
}
ORDER BY ?label
