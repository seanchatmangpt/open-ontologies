# wasm4pm-types-stub.rq
# Returns pipe-delimited event/trace type metadata for wasm4pm-types-stub template

PREFIX wasm4pm: <urn:wasm4pm:requirements:>
PREFIX w4pmstub: <https://ggen.io/onto/wasm4pm/stub/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?eventProps ?eventTypes ?traceProps ?traceTypes ?attributeProps ?attributeTypes ?lifecycles ?transitions
WHERE {
  BIND("event_id|event_type|timestamp|attributes" AS ?eventProps)
  BIND("String|String|DateTime|Map<String, Value>" AS ?eventTypes)
  BIND("case_id|events|start_time|end_time" AS ?traceProps)
  BIND("String|Vec<Event>|DateTime|DateTime" AS ?traceTypes)
  BIND("object_id|object_type|attributes|lifecycle_state" AS ?attributeProps)
  BIND("String|String|Map<String, Value>|String" AS ?attributeTypes)
  BIND("Created|InProgress|Completed|Cancelled|Active|Inactive|Seeded|Archived" AS ?lifecycles)
  BIND("LifecycleState::Created, LifecycleState::InProgress|LifecycleState::InProgress, LifecycleState::Completed|LifecycleState::InProgress, LifecycleState::Cancelled|LifecycleState::Completed, LifecycleState::Archived" AS ?transitions)
}
