# =============================================================================
# extract-skos-enums.rq — Extract admitted Zoela SHACL shapes for Zod schemas
# =============================================================================
# Returns exactly one row. Shape and field arrays are manufactured by separate
# ordered subqueries so positional bindings cannot drift through a cross-product.
# Only Zoela-domain and admitted public-role profile shapes are visible; SHACL
# surfaces from GitHub Factory, TrueX, or other imported domains are refused.
# =============================================================================

PREFIX ggen: <https://open-ontologies.org/ggen#>
PREFIX zoe:  <https://zoela.org/ontology/>
PREFIX sh:   <http://www.w3.org/ns/shacl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

SELECT
  ?shapeNames
  ?shapeTargets
  ?shapeDescriptions
  ?fieldShapes
  ?fieldNames
  ?fieldTypes
  ?fieldRequired
  ?fieldDescriptions
  ?fieldMinLengths
  ?fieldMaxLengths
  ?fieldPatterns
WHERE {
  {
    SELECT
      (GROUP_CONCAT(?shapeName; SEPARATOR="|") AS ?shapeNames)
      (GROUP_CONCAT(?shapeTarget; SEPARATOR="|") AS ?shapeTargets)
      (GROUP_CONCAT(?shapeDescription; SEPARATOR="|") AS ?shapeDescriptions)
    WHERE {
      {
        SELECT DISTINCT ?shapeName ?shapeTarget ?shapeDescription
        WHERE {
          ?shape a sh:NodeShape ; sh:property ?property .
          FILTER(
            STRSTARTS(STR(?shape), STR(ggen:)) ||
            STRSTARTS(STR(?shape), STR(zoe:))
          )
          BIND(REPLACE(STR(?shape), ".*[/#]", "") AS ?shapeName)
          OPTIONAL { ?shape sh:targetClass ?targetClass }
          OPTIONAL { ?shape sh:description ?shapeDescriptionRaw }
          OPTIONAL { ?shape rdfs:comment ?shapeCommentRaw }
          BIND(
            IF(BOUND(?targetClass), REPLACE(STR(?targetClass), ".*[/#]", ""), "")
            AS ?shapeTarget
          )
          BIND(COALESCE(?shapeDescriptionRaw, ?shapeCommentRaw, "") AS ?shapeDescription)
        }
        ORDER BY ?shapeName
      }
    }
  }
  {
    SELECT
      (GROUP_CONCAT(?fieldShape; SEPARATOR="|") AS ?fieldShapes)
      (GROUP_CONCAT(?fieldName; SEPARATOR="|") AS ?fieldNames)
      (GROUP_CONCAT(?fieldType; SEPARATOR="|") AS ?fieldTypes)
      (GROUP_CONCAT(?required; SEPARATOR="|") AS ?fieldRequired)
      (GROUP_CONCAT(?fieldDescription; SEPARATOR="|") AS ?fieldDescriptions)
      (GROUP_CONCAT(?minLength; SEPARATOR="|") AS ?fieldMinLengths)
      (GROUP_CONCAT(?maxLength; SEPARATOR="|") AS ?fieldMaxLengths)
      (GROUP_CONCAT(?pattern; SEPARATOR="|") AS ?fieldPatterns)
    WHERE {
      {
        SELECT
          ?fieldShape
          ?fieldName
          ?fieldType
          ?required
          ?fieldDescription
          ?minLength
          ?maxLength
          ?pattern
        WHERE {
          ?shape a sh:NodeShape ; sh:property ?property .
          FILTER(
            STRSTARTS(STR(?shape), STR(ggen:)) ||
            STRSTARTS(STR(?shape), STR(zoe:))
          )
          ?property sh:path ?path .
          BIND(REPLACE(STR(?shape), ".*[/#]", "") AS ?fieldShape)
          OPTIONAL { ?property sh:name ?fieldNameRaw }
          OPTIONAL { ?property sh:description ?fieldDescriptionRaw }
          OPTIONAL { ?property rdfs:comment ?fieldCommentRaw }
          OPTIONAL { ?property sh:datatype ?datatype }
          OPTIONAL { ?property sh:minCount ?minCount }
          OPTIONAL { ?property sh:minLength ?minLengthRaw }
          OPTIONAL { ?property sh:maxLength ?maxLengthRaw }
          OPTIONAL { ?property sh:pattern ?patternRaw }
          BIND(
            COALESCE(?fieldNameRaw, REPLACE(STR(?path), ".*[/#]", ""))
            AS ?fieldName
          )
          BIND(COALESCE(?fieldDescriptionRaw, ?fieldCommentRaw, "") AS ?fieldDescription)
          BIND(
            IF(!BOUND(?datatype), "string",
              IF(?datatype = xsd:boolean, "boolean",
              IF(?datatype = xsd:integer, "number",
              IF(?datatype = xsd:decimal, "number",
              IF(?datatype = xsd:dateTime, "datetime",
              IF(?datatype = xsd:anyURI, "url", "string"))))))
            AS ?fieldType
          )
          BIND(IF(BOUND(?minCount) && ?minCount >= 1, "true", "false") AS ?required)
          BIND(COALESCE(STR(?minLengthRaw), "") AS ?minLength)
          BIND(COALESCE(STR(?maxLengthRaw), "") AS ?maxLength)
          BIND(COALESCE(?patternRaw, "") AS ?pattern)
        }
        ORDER BY ?fieldShape ?fieldName
      }
    }
  }
}
