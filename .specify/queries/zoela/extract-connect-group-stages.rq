PREFIX zoe: <https://zoela.org/ontology/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT
  ?stage_codes
  ?stage_labels
  ?stage_orders
  ?stage_is_entry
  ?stage_is_terminal
  ?predecessor_codes
  ?ocel_event_types
  ?autonomic_action_classes
  ?gate_codes
WHERE {
  {
    SELECT
      (GROUP_CONCAT(?sc; separator="|") AS ?stage_codes)
      (GROUP_CONCAT(?sl; separator="|") AS ?stage_labels)
      (GROUP_CONCAT(?so; separator="|") AS ?stage_orders)
      (GROUP_CONCAT(?se; separator="|") AS ?stage_is_entry)
      (GROUP_CONCAT(?st; separator="|") AS ?stage_is_terminal)
      (GROUP_CONCAT(?pc; separator="|") AS ?predecessor_codes)
      (GROUP_CONCAT(?oe; separator="|") AS ?ocel_event_types)
      (GROUP_CONCAT(?ac; separator="|") AS ?autonomic_action_classes)
      (GROUP_CONCAT(?gc; separator="|") AS ?gate_codes)
    WHERE {
      {
        {
          BIND("cg-interest-expressed" AS ?sc)
          BIND("Interest Expressed" AS ?sl)
          BIND("1" AS ?so)
          BIND("true" AS ?se)
          BIND("false" AS ?st)
          BIND("" AS ?pc)
          BIND("connect_group.interest_expressed" AS ?oe)
          BIND("A1" AS ?ac)
          BIND("" AS ?gc)
        }
        UNION
        {
          BIND("cg-preferences-collected" AS ?sc)
          BIND("Preferences Collected" AS ?sl)
          BIND("2" AS ?so)
          BIND("false" AS ?se)
          BIND("false" AS ?st)
          BIND("cg-interest-expressed" AS ?pc)
          BIND("connect_group.preferences_collected" AS ?oe)
          BIND("A1" AS ?ac)
          BIND("" AS ?gc)
        }
        UNION
        {
          BIND("cg-eligible-groups-found" AS ?sc)
          BIND("Eligible Groups Found" AS ?sl)
          BIND("3" AS ?so)
          BIND("false" AS ?se)
          BIND("false" AS ?st)
          BIND("cg-preferences-collected" AS ?pc)
          BIND("connect_group.eligible_groups_found" AS ?oe)
          BIND("A2" AS ?ac)
          BIND("CapacityGate|ScheduleGate" AS ?gc)
        }
        UNION
        {
          BIND("cg-invite-sent" AS ?sc)
          BIND("Invite Sent" AS ?sl)
          BIND("4" AS ?so)
          BIND("false" AS ?se)
          BIND("false" AS ?st)
          BIND("cg-eligible-groups-found" AS ?pc)
          BIND("connect_group.invite_sent" AS ?oe)
          BIND("A2" AS ?ac)
          BIND("ConsentGate|NotificationBudgetGate" AS ?gc)
        }
        UNION
        {
          BIND("cg-invite-accepted" AS ?sc)
          BIND("Invite Accepted" AS ?sl)
          BIND("5" AS ?so)
          BIND("false" AS ?se)
          BIND("false" AS ?st)
          BIND("cg-invite-sent" AS ?pc)
          BIND("connect_group.invite_accepted" AS ?oe)
          BIND("A1" AS ?ac)
          BIND("CapacityGate" AS ?gc)
        }
        UNION
        {
          BIND("cg-first-meeting-attended" AS ?sc)
          BIND("First Meeting Attended" AS ?sl)
          BIND("6" AS ?so)
          BIND("false" AS ?se)
          BIND("false" AS ?st)
          BIND("cg-invite-accepted" AS ?pc)
          BIND("connect_group.first_meeting_attended" AS ?oe)
          BIND("A1" AS ?ac)
          BIND("" AS ?gc)
        }
        UNION
        {
          BIND("cg-followup-completed" AS ?sc)
          BIND("Follow-Up Completed" AS ?sl)
          BIND("7" AS ?so)
          BIND("false" AS ?se)
          BIND("false" AS ?st)
          BIND("cg-first-meeting-attended" AS ?pc)
          BIND("connect_group.followup_completed" AS ?oe)
          BIND("A1" AS ?ac)
          BIND("" AS ?gc)
        }
        UNION
        {
          BIND("cg-membership-active" AS ?sc)
          BIND("Membership Active" AS ?sl)
          BIND("8" AS ?so)
          BIND("false" AS ?se)
          BIND("true" AS ?st)
          BIND("cg-followup-completed" AS ?pc)
          BIND("connect_group.membership_active" AS ?oe)
          BIND("A1" AS ?ac)
          BIND("" AS ?gc)
        }
      }
    }
  }
}