PREFIX zoe: <https://zoela.org/ontology/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT
  ?work_order_codes
  ?work_order_labels
  ?mapped_stage_codes
  ?autonomic_action_classes
  ?requires_human_approval
WHERE {
  {
    SELECT
      (GROUP_CONCAT(?wc; separator="|") AS ?work_order_codes)
      (GROUP_CONCAT(?wl; separator="|") AS ?work_order_labels)
      (GROUP_CONCAT(?ms; separator="|") AS ?mapped_stage_codes)
      (GROUP_CONCAT(?aa; separator="|") AS ?autonomic_action_classes)
      (GROUP_CONCAT(?rh; separator="|") AS ?requires_human_approval)
    WHERE {
      {
        {
          BIND("CreateGroupInterestWorkOrder" AS ?wc)
          BIND("Create Group Interest" AS ?wl)
          BIND("cg-interest-expressed" AS ?ms)
          BIND("A1" AS ?aa)
          BIND("false" AS ?rh)
        }
        UNION
        {
          BIND("SendGroupInviteWorkOrder" AS ?wc)
          BIND("Send Group Invite" AS ?wl)
          BIND("cg-invite-sent" AS ?ms)
          BIND("A2" AS ?aa)
          BIND("false" AS ?rh)
        }
        UNION
        {
          BIND("AcceptGroupInviteWorkOrder" AS ?wc)
          BIND("Accept Group Invite" AS ?wl)
          BIND("cg-invite-accepted" AS ?ms)
          BIND("A1" AS ?aa)
          BIND("false" AS ?rh)
        }
        UNION
        {
          BIND("ReserveGroupSpotWorkOrder" AS ?wc)
          BIND("Reserve Group Spot" AS ?wl)
          BIND("cg-eligible-groups-found" AS ?ms)
          BIND("A2" AS ?aa)
          BIND("false" AS ?rh)
        }
        UNION
        {
          BIND("RecordGroupAttendanceWorkOrder" AS ?wc)
          BIND("Record Group Attendance" AS ?wl)
          BIND("cg-first-meeting-attended" AS ?ms)
          BIND("A1" AS ?aa)
          BIND("false" AS ?rh)
        }
        UNION
        {
          BIND("CreateGroupFollowUpWorkOrder" AS ?wc)
          BIND("Create Group Follow-Up" AS ?wl)
          BIND("cg-followup-completed" AS ?ms)
          BIND("A1" AS ?aa)
          BIND("false" AS ?rh)
        }
        UNION
        {
          BIND("CloseGroupJoinRouteWorkOrder" AS ?wc)
          BIND("Close Group Join Route" AS ?wl)
          BIND("cg-membership-active" AS ?ms)
          BIND("A1" AS ?aa)
          BIND("false" AS ?rh)
        }
      }
    }
  }
}