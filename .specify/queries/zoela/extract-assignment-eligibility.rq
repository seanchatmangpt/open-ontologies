# =============================================================================
# extract-assignment-eligibility.rq — Extract volunteer assignment eligibility rules
# =============================================================================
#
# Returns ONE aggregated row with pipe-delimited values for rendering
# TypeScript assignment rule constants. ggen v5 renders once per SELECT row.
#
# Source: ontology/zoela/routes.ttl (ServiceRoute named individuals)
# Uses VALUES fallback because ggen loads ontology/cli-open-ontologies.ttl
# as its single source; the zoela TTL files are not in ggen's RDF store.
#
# Template variables (all pipe-delimited GROUP_CONCAT aggregates):
#   ?route_labels         — rdfs:label per route
#   ?min_hours_list       — minimumVolunteerHours per route (0 if none)
#   ?requires_bgc_list    — "true"/"false" per route
#   ?req_skill_labels     — pipe-joined skills per route (semicolon-delimited within)
#   ?eligible_role_codes  — pipe-joined eligible role codes per route (semicolon-delimited within)
# =============================================================================

PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT
  (GROUP_CONCAT(?route_label;    SEPARATOR="|") AS ?route_labels)
  (GROUP_CONCAT(?min_hours;      SEPARATOR="|") AS ?min_hours_list)
  (GROUP_CONCAT(?req_bgc;        SEPARATOR="|") AS ?requires_bgc_list)
  (GROUP_CONCAT(?skills;         SEPARATOR="|") AS ?req_skill_labels)
  (GROUP_CONCAT(?eligible_roles; SEPARATOR="|") AS ?eligible_role_codes)
WHERE {
  {
    {
      BIND("Food Distribution Route" AS ?route_label)
      BIND("2" AS ?min_hours)
      BIND("true" AS ?req_bgc)
      BIND("Food Safety" AS ?skills)
      BIND("VOL;CARE;ADMIN;PASTOR" AS ?eligible_roles)
    }
    UNION
    {
      BIND("Care and Pastoral Route" AS ?route_label)
      BIND("4" AS ?min_hours)
      BIND("true" AS ?req_bgc)
      BIND("First Aid" AS ?skills)
      BIND("CARE;LEADER;ADMIN;PASTOR" AS ?eligible_roles)
    }
    UNION
    {
      BIND("Clothing Distribution Route" AS ?route_label)
      BIND("2" AS ?min_hours)
      BIND("true" AS ?req_bgc)
      BIND("Food Safety" AS ?skills)
      BIND("VOL;CARE;ADMIN;PASTOR" AS ?eligible_roles)
    }
    UNION
    {
      BIND("Volunteer Assignment Route" AS ?route_label)
      BIND("0" AS ?min_hours)
      BIND("true" AS ?req_bgc)
      BIND("" AS ?skills)
      BIND("LEADER;ADMIN;PASTOR" AS ?eligible_roles)
    }
    UNION
    {
      BIND("Event Registration Route" AS ?route_label)
      BIND("1" AS ?min_hours)
      BIND("false" AS ?req_bgc)
      BIND("" AS ?skills)
      BIND("VOL;LEADER;CARE;ADMIN;PASTOR" AS ?eligible_roles)
    }
    UNION
    {
      BIND("Kids Check-In Route" AS ?route_label)
      BIND("2" AS ?min_hours)
      BIND("true" AS ?req_bgc)
      BIND("Child Safety" AS ?skills)
      BIND("YTH-LEAD;ADMIN;PASTOR" AS ?eligible_roles)
    }
    UNION
    {
      BIND("Youth Event Participation Route" AS ?route_label)
      BIND("2" AS ?min_hours)
      BIND("true" AS ?req_bgc)
      BIND("Child Safety" AS ?skills)
      BIND("YTH-LEAD;LEADER;ADMIN;PASTOR" AS ?eligible_roles)
    }
    UNION
    {
      BIND("Camp Consent and Registration Route" AS ?route_label)
      BIND("2" AS ?min_hours)
      BIND("true" AS ?req_bgc)
      BIND("Child Safety" AS ?skills)
      BIND("YTH-LEAD;ADMIN;PASTOR" AS ?eligible_roles)
    }
    UNION
    {
      BIND("Baptism Registration Route" AS ?route_label)
      BIND("1" AS ?min_hours)
      BIND("false" AS ?req_bgc)
      BIND("" AS ?skills)
      BIND("LEADER;CARE;ADMIN;PASTOR" AS ?eligible_roles)
    }
    UNION
    {
      BIND("Connect Group Join Route" AS ?route_label)
      BIND("1" AS ?min_hours)
      BIND("false" AS ?req_bgc)
      BIND("" AS ?skills)
      BIND("LEADER;ADMIN;PASTOR" AS ?eligible_roles)
    }
    UNION
    {
      BIND("Partner Organization Referral Route" AS ?route_label)
      BIND("2" AS ?min_hours)
      BIND("true" AS ?req_bgc)
      BIND("Case Management" AS ?skills)
      BIND("CARE;ADMIN;PASTOR" AS ?eligible_roles)
    }
    UNION
    {
      BIND("Care Follow-Up Route" AS ?route_label)
      BIND("2" AS ?min_hours)
      BIND("true" AS ?req_bgc)
      BIND("First Aid" AS ?skills)
      BIND("CARE;LEADER;ADMIN;PASTOR" AS ?eligible_roles)
    }
    UNION
    {
      BIND("Mission Trip Participation Route" AS ?route_label)
      BIND("4" AS ?min_hours)
      BIND("true" AS ?req_bgc)
      BIND("First Aid" AS ?skills)
      BIND("VOL;LEADER;ADMIN;PASTOR" AS ?eligible_roles)
    }
  }
}