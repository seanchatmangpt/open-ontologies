# =============================================================================
# extract-wasm4pm-stub-interfaces.rq — Extract wasm4pm stub interface definitions
# =============================================================================
#
# Returns ONE aggregated row with pipe-delimited type definitions for wasm4pm.
# ggen v5 renders once per SELECT row.
#
# These stub definitions are generated directly without querying existing triples.
# The schema is derived from the wasm4pm cognition architecture.
#
# =============================================================================

PREFIX stub: <https://ggen.io/onto/wasm4pm/stub/>

SELECT
  (GROUP_CONCAT(?moduleNames; SEPARATOR="|") AS ?module_names)
  (GROUP_CONCAT(?typeNames; SEPARATOR="|") AS ?type_names)
  ("" AS ?field_names)
  ("" AS ?field_types)
  ("" AS ?method_names)
  ("" AS ?method_sigs)
  ("" AS ?method_docs)
  ("" AS ?derive_macros)
WHERE {
  # Static seed data for wasm4pm modules - returns one aggregated row per module
  VALUES (?moduleNames ?typeNames) {
    ("powl" "PowlVariant|PowlConformance")
    ("arena" "EventArena|ObjectArena")
    ("parser" "OcelParser|StreamParser")
    ("models" "DiscoveryModel|ConformanceModel|FitnessModel")
  }
}
